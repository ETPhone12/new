{
  "name": "eng3c-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Practice app for Ontario Grade 11 College English (ENG3C / NBE3C).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings src/lib/lib.test.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
